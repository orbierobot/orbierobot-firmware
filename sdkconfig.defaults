# OpenPaw firmware defaults
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Seeed Studio XIAO ESP32S3 Sense hardware
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# OTA rollback safety (app must self-validate or bootloader reverts)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# Two HTTP servers (control on 80, MJPEG on 81) plus the DNS hijack. The
# default of 10 leaves too few for httpd_start(max_open_sockets=10), which
# fails with ESP_ERR_INVALID_ARG - and ESP_ERROR_CHECK turns that into a
# reboot loop.
CONFIG_LWIP_MAX_SOCKETS=16

# FreeRTOS / logging
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# BLE provisioning (NimBLE). The app sets up Wi-Fi over BLE, so the owner
# never has to join the robot's AP first - the captive portal stays as the
# fallback for anyone without the app.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# TLS working memory.
#
# mbedtls takes its buffers from internal DRAM, and the 16KB default input
# buffer is per connection. On this board the camera framebuffers, two HTTP
# servers and TLS all compete for roughly 300KB of it, and the low-water mark
# reached 51 bytes: handshakes started failing with ALLOC_FAILED and sockets
# with ENFILE, which read like a bad CA bundle until free_internal was
# reported separately from the PSRAM-inflated total.
#
# 8KB still covers the records this API sends. The dynamic buffer is the
# bigger win - without it the buffer is held for the life of the connection
# rather than released between handshakes.
# Take mbedtls out of internal DRAM entirely. Measuring showed this was not
# a leak - free_internal swings between 2KB and 31KB and recovers - but the
# robot simply lives too close to the floor, so a handshake that lands on a
# low point fails and cloud_online flickers. PSRAM has megabytes spare and
# mbedtls buffers are not DMA, so they belong there. With the buffers off
# internal memory the input length can go back to the full 16KB, which also
# removes the risk of a server sending a record larger than a reduced buffer.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
