	(text "ORBIE V5 — DOCK BASE BOARD r0.1. Pads dead until a robot is present; feeder works without the robot; 70 x 54 mm, 2-layer."
		(exclude_from_sim no)
		(at 20 10 0)
		(effects
			(font
				(size 3.0 3.0) bold
			)
			(justify left)
		)
		(uuid "d4c76de0-d605-438a-9d3f-8ee4aeec6c7f")
	)
	(text "U1 XIAO ESP32-C3 — dock controller (Wi-Fi to app, schedules feeding without the robot, REQ-D3). D0 hall, D1 pad enable, D2 ISENSE (ADC), D3 drop sensor, D4/D5 bus I2C, D6/D7 UART to bus, D8 IR_L, D9 IR_R, D10 button"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "1786d0b8-fc38-42a5-a593-74bcc10cf5d3")
	)
	(text "POWER IN  USB-C 5V/3A (CC 5k1), TVS, 3A polyfuse.  PADS: AO3401A high-side switch, 100k pull-down, 0.05R shunt + ADC fold-back; pads are DEAD until hall + handshake (REQ-D1)"
		(exclude_from_sim no)
		(at 20 90 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "0c38d102-856d-4daf-b785-d8f40a47b94a")
	)
	(text "ISENSE = midpoint of the shunt divider -> C3 ADC reads (PAD_V-PAD_OUT)/2 referenced to PAD_OUT; firmware folds back > 2.5 A and reports shorts"
		(exclude_from_sim no)
		(at 250 148 0)
		(effects
			(font
				(size 1.4 1.4) bold
			)
			(justify left)
		)
		(uuid "d2c980ba-6a2c-46dd-b4b7-c9f29397dec4")
	)
	(text "HOMING  2x 940 nm IR LEDs (L/R lobes) at 38 kHz from the C3 via MMBT2222A, 33R from 5V.  U2 hall AH1806: robot magnet = present.  SW1 button: feed now / hold = pair"
		(exclude_from_sim no)
		(at 20 175 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "c928a0ba-e102-4d29-ac78-823d96125fd4")
	)
	(text "MODULES  U3 DRV8833 drives the feeder paddle motor (A) and the water pump (B) through the stacking bus J2 (10p: 5V GND FEED_A FEED_B PUMP_A PUMP_B DROP PRESENT_F LEVEL PRESENT_W). Modules are dumb; motors live in the modules (REQ-D4)"
		(exclude_from_sim no)
		(at 20 245 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
