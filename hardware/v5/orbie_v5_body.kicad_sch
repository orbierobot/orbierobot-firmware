	(text "ORBIE V5 — BODY CONTROLLER r0.2 (applies HW requirements 26 Sep 2026). Retrofit outline of the V3 Main PCB drawing — CONFIRM mounting pattern against the body before fab."
		(exclude_from_sim no)
		(at 20 10 0)
		(effects
			(font
				(size 3.0 3.0) bold
			)
			(justify left)
		)
		(uuid "41f54978-5e22-481b-adde-8180dec3f91e")
	)
	(text "U1  XIAO RP2040 — 1 kHz balance loop. D0-D3 encoders (PIO), D4/D5 I2C_M (IMU + ADS1015), D6/D7 UART to head, D8/D9 locked-antiphase PWM, D10 bumper"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "0a4a508b-516d-4845-b45c-6049edcfb77f")
	)
	(text "U2 LSM6DS3 IMU on the axle line (REQ-S1/N2)   U16 ADS1015: AIN0/1 cliff IR (REQ-S4), AIN2/3 motor current via 0.1R on AISEN/BISEN (REQ-S5)"
		(exclude_from_sim no)
		(at 160 18 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "da3a0f8c-6f21-4e8e-a114-0ba9b67decab")
	)
	(text "U3 DRV8833 locked-antiphase (IN1 = PWM, IN2 = NOT PWM via U4/U5). nSLEEP from expander, default LOW (pull-down). 0.1R sense -> chopping limit 2 A + ADC current sense"
		(exclude_from_sim no)
		(at 20 95 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "f95e7250-7b3c-4380-8369-68edd306260a")
	)
	(text "POWER  USB-C 6P (TVS, REQ-R5) or belly POGO -> OR diodes -> BQ24074 1S charger/power path -> VSYS.  Pack: 1S2P 18650 + DW01A/2xAO3400 protection (REQ-P1) + NTC on TS (REQ-P2)"
		(exclude_from_sim no)
		(at 20 185 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "ffbeec2a-1996-4328-b36b-0f1aa2c477a6")
	)
	(text "U7 LC709203F fuel gauge @0x0B (battery_pct for REQ-P4/P5)   U8 MT3608 5V/2A   U9 AP2112K 3V3_E   D5 isolates the head 5V so the XIAO's USB can never back-feed a laptop (REQ-R5)"
		(exclude_from_sim no)
		(at 20 275 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "5c03491b-63b8-4cac-b86c-c670cac2c535")
	)
	(text "U15 TCA9517A I2C buffer: body bus (A) <-> neck harness (B) so a failing head sensor cannot hang the body (REQ-R1)   U10 TCA9534 @0x38: CHG, PGOOD, nFAULT, SERVO_PWR, DOCK_DET, DRV_nSLEEP, ToF LPn L/R"
		(exclude_from_sim no)
		(at 20 345 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "c77599d1-d31c-436c-8fa7-309b654e9442")
	)
	(text "J15/J16/J17  3x VL53L5CX 8x8 multizone ToF (front, left, right) on the body bus (REQ-N3 option A). Front LPn tied high; L/R LPn from the expander to assign addresses at boot"
		(exclude_from_sim no)
		(at 230 345 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "8453aec3-89e9-4654-8de2-ba306ec10cd7")
	)
	(text "AUDIO  MAX98357A on +5V. JP2 GAIN strap: GND=12 dB | open=9 dB | VDD=6 dB, R20 100k->VDD = 3 dB (REQ-A2). Speaker: sealed-back 4R 3W (REQ-A1)"
		(exclude_from_sim no)
		(at 230 400 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "b8df7d85-b632-40fd-a75c-4ce967653b79")
	)
	(text "J7 NECK HARNESS 16p: GND +5V_HEAD 3V3 SDA_H SCL_H UART I2S SERVO IR_RX LIDAR_RX XIAO_RST XIAO_BOOT.  J12 LD19 lidar in the base (REQ-N4): 5V, TX->GPIO4 of the head XIAO.  SW2/SW3 recessed RESET/BOOT (REQ-X1..X4)"
		(exclude_from_sim no)
		(at 20 470 0)
		(effects
			(font
				(size 2.0 2.0) bold
			)
			(justify left)
		)
		(uuid "416175ef-6c83-4f44-a9bd-9b6c8ee24b2d")
	)
	(text "head side: 6=GPIO1(TX) 7=GPIO2(RX) 12=GPIO3 13=GPIO4 14/15=XIAO RST/BOOT pads"
